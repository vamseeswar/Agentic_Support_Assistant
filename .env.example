# Trendly Support Assistant Environment Configuration

# LLM Provider: "gemini" (recommended for free tier) or "mock" (offline test mode)
LLM_PROVIDER=gemini

# Model name: e.g. "gemini-1.5-flash" or "gemini-2.0-flash" (both on free tier)
LLM_MODEL=gemini-1.5-flash

# API Key for Google Gemini (Get free key from https://aistudio.google.com/)
# If using LLM_PROVIDER=mock, no API key is required.
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=production
